# =========================================================
# Oil Spill Intelligence Platform - Backend Environment
# =========================================================

# Database:
# If PostgreSQL is running:
DATABASE_URL=postgresql+asyncpg://oilspill:oilspill_dev@localhost:5432/oilspill
DATABASE_URL_SYNC=postgresql://oilspill:oilspill_dev@localhost:5432/oilspill
# NOTE: If PostgreSQL is not running, the application will automatically fall back to SQLite!
# (sqlite+aiosqlite:///./oilspill.db)

# Authentication
JWT_SECRET=hackathon-oil-spill-secret-key-2024
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------
# EXTERNAL API KEYS (Optional)
# ---------------------------------------------------------

# 1. aisstream.io API Key (Free live WebSocket stream for all ships/tankers)
# Get your free key from: https://aisstream.io -> Dashboard
AISSTREAM_API_KEY=your_aisstream_api_key_here

# 2. Copernicus Climate Data Store (CDS - ERA5 Wind Data)
# Get your free Personal Access Token from: https://cds.climate.copernicus.eu/how-to-api
CDS_API_KEY=your_copernicus_cds_key_here

# Anomaly Detection Thresholds
SPEED_DROP_THRESHOLD=2.0
SPEED_DROP_DURATION=10.0
COURSE_CHANGE_THRESHOLD=45.0
AIS_GAP_THRESHOLD=30.0
ROUTE_DEVIATION_THRESHOLD=5.0