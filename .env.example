# =========================================================
# AegisOcean - Root Environment Configuration Template
# =========================================================

# Database Configuration (Docker Compose)
POSTGRES_DB=oilspill
POSTGRES_USER=oilspill
POSTGRES_PASSWORD=oilspill_dev
DATABASE_URL=postgresql+asyncpg://oilspill:oilspill_dev@db:5432/oilspill

# Backend Auth & Security
JWT_SECRET=hackathon-oil-spill-secret-key-2024
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS Whitelist
CORS_ORIGINS=http://localhost:5173

# Frontend API URL
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------
# EXTERNAL APIS (Optional for live feeds)
# ---------------------------------------------------------
# 1. aisstream.io API Key (Free live WebSocket stream for ships/tankers)
# Register for a free key at: https://aisstream.io
AISSTREAM_API_KEY=your_aisstream_api_key_here

# 2. Copernicus Climate Data Store (CDS - ERA5 Wind Data)
# Register at: https://cds.climate.copernicus.eu/how-to-api
CDS_API_KEY=your_copernicus_cds_key_here